# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.

# ── 공공데이터포털 (data.go.kr / api.odcloud.kr) ──────────────
# 마이페이지 > 오픈API > 인증키 발급현황 에서 확인
# Encoding(URL 인코딩된) 키를 그대로 넣습니다.
ODCLOUD_SERVICE_KEY_ENC=

# 각 데이터셋의 오픈API 엔드포인트 경로
# data.go.kr 해당 데이터 페이지 > 오픈API 탭 > 요청주소 에서 확인
KOGAS_POWER_GEN_PATH=
KOGAS_WHOLESALE_PATH=

# ── Supabase (데이터 동기화용) ────────────────────────────────
# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
